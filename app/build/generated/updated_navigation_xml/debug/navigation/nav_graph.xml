<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/loginFragment" >
<fragment
    android:id="@+id/loginFragment"
    android:name="com.example.primecare.ui.login.LoginFragment"
    android:label="Login"
    tools:layout="@layout/fragment_login" >

    <action
        android:id="@+id/action_login_to_register"
        app:destination="@id/registerFragment" />
    <action
        android:id="@+id/action_login_to_adminDashboard"
        app:destination="@id/adminDashboardFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_login_to_doctorDashboard"
        app:destination="@id/doctorDashboardFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

</fragment>

<!-- Reachable from anywhere -->
<action
    android:id="@+id/action_global_settings"
    app:destination="@id/settingsFragment" />
<action
    android:id="@+id/action_global_help"
    app:destination="@id/helpFragment" />
<fragment
    android:id="@+id/registerFragment"
    android:name="com.example.primecare.ui.login.RegisterFragment"
    android:label="Register"
    tools:layout="@layout/fragment_register" />
<fragment
    android:id="@+id/settingsFragment"
    android:name="com.example.primecare.ui.settings.SettingsFragment"
    android:label="Settings"
    tools:layout="@layout/fragment_settings" >

    <action
        android:id="@+id/action_settings_to_help"
        app:destination="@id/helpFragment" />
    <action
        android:id="@+id/action_settings_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/helpFragment"
    android:name="com.example.primecare.ui.settings.HelpFragment"
    android:label="Help"
    tools:layout="@layout/fragment_help" />
<fragment
    android:id="@+id/adminDashboardFragment"
    android:name="com.example.primecare.ui.admin.AdminDashboardFragment"
    android:label="Admin Dashboard"
    tools:layout="@layout/fragment_admin_dashboard" >

    <action
        android:id="@+id/action_adminDashboard_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/adminDashboardFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_adminDashboard_to_appointmentsList"
        app:destination="@id/appointmentsListFragment" />
    <action
        android:id="@+id/action_adminDashboard_to_checkin"
        app:destination="@id/checkinFragment" />
    <action
        android:id="@+id/action_adminDashboard_to_queue"
        app:destination="@id/queueFragment" />
    <action
        android:id="@+id/action_adminDashboard_to_assignDoctor"
        app:destination="@id/assignDoctorFragment" />
    <action
        android:id="@+id/action_adminDashboard_to_registerWalkin"
        app:destination="@id/registerWalkinFragment" />

</fragment>
<fragment
    android:id="@+id/appointmentsListFragment"
    android:name="com.example.primecare.ui.admin.AppointmentsListFragment"
    android:label="Today&apos;s Appointments"
    tools:layout="@layout/fragment_appointments_list" />
<fragment
    android:id="@+id/checkinFragment"
    android:name="com.example.primecare.ui.admin.CheckinFragment"
    android:label="Check-in"
    tools:layout="@layout/fragment_checkin" />
<fragment
    android:id="@+id/queueFragment"
    android:name="com.example.primecare.ui.admin.QueueFragment"
    android:label="Queue"
    tools:layout="@layout/fragment_queue" />
<fragment
    android:id="@+id/assignDoctorFragment"
    android:name="com.example.primecare.ui.admin.AssignDoctorFragment"
    android:label="Assign Doctor"
    tools:layout="@layout/fragment_assign_doctor" />
<fragment
    android:id="@+id/registerWalkinFragment"
    android:name="com.example.primecare.ui.admin.RegisterWalkinFragment"
    android:label="Register Walk-in"
    tools:layout="@layout/fragment_register_walkin" />
<fragment
    android:id="@+id/doctorDashboardFragment"
    android:name="com.example.primecare.ui.doctor.DoctorDashboardFragment"
    android:label="Doctor Dashboard"
    tools:layout="@layout/fragment_doctor_dashboard" >

    <action
        android:id="@+id/action_doctorDashboard_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/doctorDashboardFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_doctorDashboard_to_consultation"
        app:destination="@id/consultationFragment" />
    <action
        android:id="@+id/action_doctorDashboard_to_repeatRequests"
        app:destination="@id/repeatRequestsFragment" />

</fragment>
<fragment
    android:id="@+id/consultationFragment"
    android:name="com.example.primecare.ui.doctor.ConsultationFragment"
    android:label="Consultation"
    tools:layout="@layout/fragment_consultation" >

    <action
        android:id="@+id/action_consultation_to_prescription"
        app:destination="@id/prescriptionFragment" />
    <action
        android:id="@+id/action_consultation_to_followup"
        app:destination="@id/followupFragment" />

</fragment>
<fragment
    android:id="@+id/prescriptionFragment"
    android:name="com.example.primecare.ui.doctor.PrescriptionFragment"
    android:label="Prescription"
    tools:layout="@layout/fragment_prescription" />
<fragment
    android:id="@+id/followupFragment"
    android:name="com.example.primecare.ui.doctor.FollowupFragment"
    android:label="Follow-up"
    tools:layout="@layout/fragment_followup" />
<fragment
    android:id="@+id/repeatRequestsFragment"
    android:name="com.example.primecare.ui.doctor.RepeatRequestsFragment"
    android:label="Repeat Requests"
    tools:layout="@layout/fragment_repeat_requests" />
</navigation>