<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/pc_grey_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <include android:id="@+id/topBar" layout="@layout/include_topbar_back" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add prescription" android:textColor="@color/pc_text_dark" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/prescriptionPatientText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Loading patient..." android:textColor="@color/pc_text_grey" android:textSize="13sp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="Medication" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:text="Fields marked * are required." android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_grey" android:textSize="12sp" /><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Medication * (e.g. Amoxicillin 500 mg capsules)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/medicationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Dose * (e.g. 1 capsule)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/dosageInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="How often * (e.g. 3 times a day)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/frequencyInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="For how long (e.g. 7 days)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/durationInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Instructions (e.g. take after food)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/instructionsInput" android:layout_width="match_parent" android:layout_height="80dp" android:gravity="top" android:inputType="textMultiLine|textCapSentences" /></com.google.android.material.textfield.TextInputLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/savePrescriptionButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:backgroundTint="@color/pc_blue" android:text="Save and finish" app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/saveAnotherButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Save and add another" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>