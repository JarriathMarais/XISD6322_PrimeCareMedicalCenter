<?xml version="1.0" encoding="utf-8"?>
<!--
  PrimeCare Network Security Config.

  Cleartext HTTP is allowed so the app can reach a development server
  (XAMPP on the emulator's 10.0.2.2, or your PC's LAN IP from a real
  phone). A hosted server should use https:// — HTTPS works with this
  config too. Before a real clinic deployment, serve the API over HTTPS
  and set cleartextTrafficPermitted to false.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
