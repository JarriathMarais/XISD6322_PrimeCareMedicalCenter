<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/pc_grey_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <include android:id="@+id/topBar" layout="@layout/include_topbar_back" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Help and user guide" android:textColor="@color/pc_text_dark" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tap through the sections below." android:textColor="@color/pc_text_grey" android:textSize="13sp" />
            <!-- YOUR CARDS SAME AS BEFORE - I KEPT THEM ALL -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="1. Getting started" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Log in with your staff email and password, or tap Sign in with Google if your clinic email is linked. New here? Tap Create a staff account, fill in every field and enter the clinic registration code from your administrator. Passwords need 8 or more characters with a letter and a number. Cannot connect? Tap Server settings on the login screen, enter the server address and tap Test connection." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="2. Reception: a booked patient arrives" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="1. Patient Check-in: search the name and tap Check In. The patient gets a queue number such as Q-01. 2. Assign Doctor: bookings made on the website have no doctor yet. Choose an active doctor and tap Assign. 3. Queue Management shows who is with a doctor and who is waiting. It refreshes by itself." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="3. Reception: a walk-in patient" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tap Register Walk-in, enter the name, phone number and reason, then tap Register. The patient joins the queue straight away. Use Assign Doctor afterwards." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="4. Doctor: seeing a patient" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Your dashboard lists your checked-in patients. Tap a patient, or tap Call Next Patient. The consultation has five sections. Save draft keeps your work and the patient stays in your queue. Finalize completes the visit." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="5. Doctor: prescriptions and follow-ups" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="In section 4 tap Add prescription. Medication, dose and how often are required. To book a follow-up, choose a date in section 5. The appointment is booked automatically when you finalize." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="6. Doctor: repeat requests" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="On your dashboard tap View Repeat Requests. These are requests patients made on the website. Tap Approve or Decline and the patient is notified." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="7. Settings" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Open Settings from your dashboard to change your name, change your password, set the server address, switch queue auto-refresh on or off, or sign out." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/pc_white"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:text="8. Problems" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pc_text_dark" android:textSize="16sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Could not reach the server: check your Wi-Fi, then Settings, Server address, Test connection. Session expired: you are signed out after 12 hours. Log in again." android:textColor="@color/pc_text_grey" android:textSize="14sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>